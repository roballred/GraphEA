{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphea:schema:common",
  "title": "GraphEA common definitions",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "edgeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "origin": { "enum": ["documented", "observed", "asserted", "synthetic"] },
    "verification": { "enum": ["unverified", "verified"] },
    "states": {
      "oneOf": [
        { "const": ["past"] },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["current", "target"] }
        }
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "partialDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidenceItem": {
      "type": "object",
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "rawItem": { "$ref": "#/$defs/slug" },
        "rawHash": { "$ref": "#/$defs/sha256" },
        "convertedHash": { "$ref": "#/$defs/sha256" },
        "locator": {
          "type": "object",
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "section": { "type": "string", "minLength": 1 },
            "table": { "type": "string", "minLength": 1 },
            "quote": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": ["key", "rawItem", "rawHash"],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["id", "type", "from", "to", "provenance",
                          "verification", "verifiedAt", "verifiedBy", "verifiedHash"] }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
          "origin": { "$ref": "#/$defs/origin" }
        },
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "claims": { "$ref": "#/$defs/claims" },
        "extractionRun": { "type": "string", "minLength": 1, "readOnly": true },
        "curatedBy": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/timestamp", "readOnly": true },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["evidence", "curatedBy", "sessionId", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "trustRules": {
      "allOf": [
        {
          "if": { "properties": { "verification": { "const": "verified" } }, "required": ["verification"] },
          "then": { "required": ["verifiedAt", "verifiedBy", "verifiedHash"] },
          "else": { "not": { "anyOf": [{ "required": ["verifiedAt"] }, { "required": ["verifiedBy"] },
                                       { "required": ["verifiedHash"] }] } }
        },
        {
          "if": { "properties": { "origin": { "enum": ["documented", "observed"] } }, "required": ["origin"] },
          "then": { "properties": { "provenance": { "properties": { "evidence": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "origin": { "const": "synthetic" } }, "required": ["origin"] },
          "then": { "properties": { "provenance": { "properties": { "evidence": { "maxItems": 0 } } } } }
        }
      ]
    }
  }
}
